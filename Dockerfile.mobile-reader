# Rebuild the frontend on top of the exact matching upstream runtime.
ARG BASE_IMAGE=ghcr.io/hkuds/deeptutor@sha256:9b8b21ea8861434868ba20adf70966ad9dce193c507c2dcceffbe57264306da8
FROM node:22.23.4-slim AS frontend
WORKDIR /app/web
COPY web/package.json web/package-lock.json ./
RUN npm ci --legacy-peer-deps --replace-registry-host=always --no-audit --no-fund
COPY web/ ./
COPY deeptutor/__version__.py /app/deeptutor/__version__.py
ENV NEXT_TELEMETRY_DISABLED=1
RUN npm run build

FROM ${BASE_IMAGE}
ARG SOURCE_REVISION
LABEL org.opencontainers.image.source="https://github.com/lorinlee/DeepTutor" \
      org.opencontainers.image.revision="${SOURCE_REVISION}"
RUN rm -rf /app/web && install -d -o deeptutor -g deeptutor /app/web
COPY --from=frontend --chown=deeptutor:deeptutor /app/web/.next/standalone/ /app/web/
